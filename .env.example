# Copy to .env; use a dedicated Listmonk API user and generated token.
LISTMONK_MCP_URL=http://localhost:9000
LISTMONK_MCP_USERNAME=your-api-user
LISTMONK_MCP_PASSWORD=your-api-token

# Optional settings.
LISTMONK_MCP_TIMEOUT=30
# Retries apply only to GET/HEAD requests; writes are never retried automatically.
LISTMONK_MCP_MAX_RETRIES=3
LISTMONK_MCP_DEBUG=false
LISTMONK_MCP_LOG_LEVEL=INFO
